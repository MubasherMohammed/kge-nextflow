// ============================================================================
// KGE-nextflow — CRISPR KO Screen Analysis Pipeline
// Demultiplexing → MAGeCK count/test/MLE → Interactive HTML Report
// ============================================================================

manifest {
    name            = 'kge'
    author          = 'Mubasher Mohammed'
    description     = 'CRISPR KO screen analysis: flowcell demultiplexing → MAGeCK → interactive HTML report'
    version         = '1.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04'
    homePage        = 'https://github.com/MubasherMohammed/kge-nextflow'
}

// ---------------------------------------------------------------------------
// Default parameters
// ---------------------------------------------------------------------------
params {

    // -- Input: demultiplexing (BCL → FASTQ) --------------------------------
    run_folder              = ''                // Illumina run folder (BCL dir)
    sample_sheet            = ''                // SampleSheet.csv path
    demultiplex             = false             // Set true to start from BCL
    bcl_converter           = 'bcl-convert'     // 'bcl-convert' or 'bcl2fastq'

    // -- Input: direct FASTQ (skip demux) ------------------------------------
    fastq_dir               = ''                // Directory containing FASTQ files
    fastq_pattern           = '*{R1,R2}_*{fastq,fastq.gz,fq,fq.gz}'

    // -- Input: pre-computed count table (skip demux + count) ----------------
    count_table             = ''                // Path to existing .count.txt (skip counting)

    // -- Library & sample metadata -------------------------------------------
    library_file            = ''                // sgRNA library file (required for FASTQ mode)
    sample_labels           = ''                // Comma-separated sample labels

    // -- Analysis input files ------------------------------------------------
    // Provide --comparisons for RRA, --design_matrix for MLE, or both.
    // The pipeline auto-detects: comparisons → RRA, design_matrix → MLE, both → RRA+MLE.
    comparisons             = ''                // TSV file: treatment<TAB>control (one pair per row)
    design_matrix           = ''                // Design matrix file (required for MLE)

    // -- MAGeCK count options ------------------------------------------------
    norm_method              = 'median'          // 'none', 'median', 'total', 'control'
    control_sgrna            = ''                // Control sgRNA file
    control_gene             = ''                // Control gene file
    sgrna_len                = 20                // sgRNA length
    trim5                    = 'AUTO'            // 5' trim length or 'AUTO'
    count_n                  = false             // Count sgRNAs with Ns
    reverse_complement       = false             // Reverse complement library

    // -- MAGeCK test (RRA) options -------------------------------------------
    adjust_method            = 'fdr'             // 'fdr', 'holm', 'pounds'
    gene_test_fdr_threshold  = 0.25
    remove_zero              = 'both'            // 'none','control','treatment','both','any'
    gene_lfc_method          = 'median'          // 'median','mean','alphamedian','alphamean','secondbest'

    // -- MAGeCK MLE options --------------------------------------------------
    include_samples          = ''                // Comma-separated sample labels for MLE
    beta_labels              = ''                // Comma-separated beta labels
    threads                   = 1                 // Threads for MLE
    permutation_round        = 2                 // Permutation rounds for MLE

    // -- HTML report options --------------------------------------------------
    html_report              = true              // Generate HTML report
    skip_enrichment          = false             // Skip pathway enrichment
    enrichment_top_n         = 50                // Top genes for enrichment
    enrichment_fdr           = 0.05              // FDR for enrichment significance
    organism                 = 'human'           // 'human' or 'mouse'
    fdr_threshold            = 0.05              // FDR threshold for plots
    top_n                    = 20                // Top genes to label

    // -- QC -------------------------------------------------------------------
    fastqc                   = true              // Run FastQC
    multiqc                  = true              // Run MultiQC

    // -- Output ---------------------------------------------------------------
    output_dir               = './results'
    output_prefix            = 'mageck'

    // -- Container images (Docker/Singularity) --------------------------------
    containers {
        bcl_convert     = 'quay.io/biocontainers/bcl-convert:4.0.3--h57d0181_0'
        fastqc          = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        multiqc         = 'quay.io/biocontainers/multiqc:1.25.1--pyh7e72e4a_0'
        mageck          = 'mubasher/mageck-kge:0.5.9.5'  // Custom image with KGE
    }
}

// ---------------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------------
process {
    cpus   = 1
    memory = '8.GB'
    time   = '24.h'

    withName: 'DEMULTIPLEX' {
        cpus   = 8
        memory = '32.GB'
        time   = '48.h'
    }
    withName: 'FASTQC_READS' {
        cpus   = 2
        memory = '4.GB'
    }
    withName: 'MAGECK_COUNT' {
        cpus   = 4
        memory = '16.GB'
        time   = '24.h'
    }
    withName: 'MAGECK_TEST_RRA' {
        cpus   = 4
        memory = '16.GB'
    }
    withName: 'MAGECK_MLE_ANALYSIS' {
        cpus   = params.threads
        memory = '16.GB'
    }
    withName: 'KGE_REPORT' {
        cpus   = 2
        memory = '8.GB'
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

profiles {

    // Local execution with conda
    conda {
        process.executor = 'local'
        conda.enabled = true
        conda.envsDir = '/Users/mubasher.mohammed/miniconda3/envs'
        process {
            withName: 'MAGECK_COUNT'        { conda = 'mageckenv' }
            withName: 'MAGECK_TEST_RRA'     { conda = 'mageckenv' }
            withName: 'MAGECK_MLE_ANALYSIS' { conda = 'mageckenv' }
            withName: 'KGE_REPORT'          { conda = 'mageckenv' }
        }
        params.fastqc = true
    }

    // Docker
    docker {
        docker.enabled = true
        process {
            withName: 'DEMULTIPLEX'         { container = params.containers.bcl_convert }
            withName: 'FASTQC_READS'       { container = params.containers.fastqc }
            withName: 'MULTIQC_REPORT'      { container = params.containers.multiqc }
            withName: 'MAGECK_COUNT'        { container = params.containers.mageck }
            withName: 'MAGECK_TEST_RRA'     { container = params.containers.mageck }
            withName: 'MAGECK_MLE_ANALYSIS' { container = params.containers.mageck }
            withName: 'KGE_REPORT'          { container = params.containers.mageck }
        }
    }

    // Singularity (HPC)
    singularity {
        singularity.enabled = true
        process {
            withName: 'DEMULTIPLEX'         { container = params.containers.bcl_convert }
            withName: 'FASTQC_READS'        { container = params.containers.fastqc }
            withName: 'MULTIQC_REPORT'       { container = params.containers.multiqc }
            withName: 'MAGECK_COUNT'        { container = params.containers.mageck }
            withName: 'MAGECK_TEST_RRA'     { container = params.containers.mageck }
            withName: 'MAGECK_MLE_ANALYSIS' { container = params.containers.mageck }
            withName: 'KGE_REPORT'          { container = params.containers.mageck }
        }
    }

    // SLURM (HPC cluster)
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        process.time     = '48.h'
    }

    // Dardel (PDC/KTH) — uses module system
    dardel {
        process.executor = 'local'
        params.fastqc = true
        // Pre-activate the mageckenv conda environment before running:
        //   ml PDC/23.12 ml miniconda3/25.3.1-1-cpeGNU-24.11
        //   conda activate mageckenv
        //   nextflow run kge -profile dardel ...
    }
}

// ---------------------------------------------------------------------------
// Execution log & report
// ---------------------------------------------------------------------------
timeline {
    enabled = true
    file    = 'timeline.html'
}

trace {
    enabled = true
    file    = 'trace.txt'
}

report {
    enabled = true
    file    = 'report.html'
}

dag {
    enabled = true
    file    = 'dag.svg'
}